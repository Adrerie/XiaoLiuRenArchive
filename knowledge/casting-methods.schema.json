{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaoliurenarchive.local/schemas/casting-methods.schema.json",
  "title": "XiaoLiuRen Casting Methods",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeVersion", "status", "methods"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "knowledgeVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["provisional", "reviewed", "canonical"]},
    "methods": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/method"}}
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "inputKind", "ruleSummary", "pathFields", "primaryPalacePosition", "sourceStatus", "sourceIds", "version", "supportedInterpretationLayers", "unsupportedClaims"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "category": {"enum": ["traditional-core", "modern-variant"]},
        "inputKind": {"enum": ["calendar", "three_numbers"]},
        "ruleSummary": {"type": "string", "minLength": 1},
        "pathFields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primaryPalacePosition": {"type": "string", "minLength": 1},
        "sourceStatus": {"enum": ["provisional", "reviewed", "canonical"]},
        "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "version": {"type": "string", "minLength": 1},
        "supportedInterpretationLayers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unsupportedClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaoliurenarchive.local/schemas/ethics-rules.schema.json",
  "title": "XiaoLiuRen Ethics Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeVersion", "status", "enginePolicy", "rules"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "knowledgeVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["provisional", "reviewed", "canonical"]},
    "enginePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationOrder", "defaultMode", "principles", "claimTypes"],
      "properties": {
        "evaluationOrder": {"const": "priority-descending-then-id-ascending"},
        "defaultMode": {"enum": ["allow-with-source-trace", "deny-unmatched"]},
        "principles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claimTypes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "condition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "always": {"type": "boolean"},
        "domainEquals": {"type": "string"},
        "factEquals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}},
        "questionHasAnyFlag": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "outputContainsAnyTag": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "severity", "scope", "when", "effects", "requiredNotice", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "severity": {"enum": ["hard-stop", "hard-block", "hard-constraint", "language-constraint", "notice"]},
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "when": {"$ref": "#/$defs/condition"},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}},
        "requiredNotice": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaoliurenarchive.local/schemas/calendar-policies.schema.json",
  "title": "XiaoLiuRen Calendar Policies",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "defaultPolicyId", "policies"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "policyVersion": {"type": "string", "minLength": 1},
    "defaultPolicyId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policy"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "dayBoundary", "ziHour", "leapMonth", "timezone", "dst", "manualInput", "disclosure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["default", "alternative", "experimental", "deprecated"]},
        "dayBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "description"],
          "properties": {
            "mode": {"enum": ["civil_midnight", "zi_hour_23", "split_early_late_zi"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "ziHour": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branchIndex", "intervals"],
          "properties": {
            "branchIndex": {"const": 1},
            "intervals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start", "end", "dayOffset"],
                "properties": {
                  "start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                  "end": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                  "dayOffset": {"type": "integer", "minimum": -1, "maximum": 1}
                }
              }
            }
          }
        },
        "leapMonth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "description"],
          "properties": {
            "mode": {"enum": ["reuse_month_number", "reject_for_manual_review", "custom_mapping"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "timezone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "conversionOrder"],
          "properties": {
            "input": {"enum": ["iana_required", "iana_preferred_with_local_fallback"]},
            "conversionOrder": {"const": "instant-to-local-time-before-calendar-conversion"}
          }
        },
        "dst": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "use-timezone-database"}}
        },
        "manualInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiresLeapFlag", "requiresBranch"],
          "properties": {
            "requiresLeapFlag": {"type": "boolean"},
            "requiresBranch": {"type": "boolean"}
          }
        },
        "disclosure": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}

      "expected": {"monthIndex": 3, "monthPalaceId": "chi_kou", "dayIndex": 0, "dayPalaceId": "da_an", "hourIndex": 0, "hourPalaceId": "da_an", "finalPalaceId": "da_an"}
    },
    {
      "id": "eleventh-month-twenty-ninth-day-mao",
      "description": "一般跨周期案例，最终落空亡",
      "input": {"lunarMonth": 11, "lunarDay": 29, "earthlyBranchIndex": 4},
      "expected": {"monthIndex": 4, "monthPalaceId": "xiao_ji", "dayIndex": 2, "dayPalaceId": "su_xi", "hourIndex": 5, "hourPalaceId": "kong_wang", "finalPalaceId": "kong_wang"}
    }
  ],
  "invalidCases": [
    {"id": "month-zero", "input": {"lunarMonth": 0, "lunarDay": 1, "earthlyBranchIndex": 1}, "expectedErrorCode": "INVALID_LUNAR_MONTH"},
    {"id": "month-thirteen", "input": {"lunarMonth": 13, "lunarDay": 1, "earthlyBranchIndex": 1}, "expectedErrorCode": "INVALID_LUNAR_MONTH"},
    {"id": "day-zero", "input": {"lunarMonth": 1, "lunarDay": 0, "earthlyBranchIndex": 1}, "expectedErrorCode": "INVALID_LUNAR_DAY"},
    {"id": "day-thirty-one", "input": {"lunarMonth": 1, "lunarDay": 31, "earthlyBranchIndex": 1}, "expectedErrorCode": "INVALID_LUNAR_DAY"},
    {"id": "branch-zero", "input": {"lunarMonth": 1, "lunarDay": 1, "earthlyBranchIndex": 0}, "expectedErrorCode": "INVALID_EARTHLY_BRANCH_INDEX"},
    {"id": "branch-thirteen", "input": {"lunarMonth": 1, "lunarDay": 1, "earthlyBranchIndex": 13}, "expectedErrorCode": "INVALID_EARTHLY_BRANCH_INDEX"},
    {"id": "non-integer-day", "input": {"lunarMonth": 1, "lunarDay": 1.5, "earthlyBranchIndex": 1}, "expectedErrorCode": "NON_INTEGER_INPUT"},
    {"id": "missing-field", "input": {"lunarMonth": 1, "lunarDay": 1}, "expectedErrorCode": "MISSING_INPUT_FIELD"}
  ],
  "propertyTests": [
    {
      "id": "all-valid-indices-in-range",
      "range": {"lunarMonth": [1, 12], "lunarDay": [1, 30], "earthlyBranchIndex": [1, 12]},
      "assertion": "monthIndex, dayIndex and hourIndex are integers in 0..5"
    },
    {
      "id": "stepwise-equals-compressed",
      "range": {"lunarMonth": [1, 12], "lunarDay": [1, 30], "earthlyBranchIndex": [1, 12]},
      "assertion": "hourIndex === positiveMod(lunarMonth + lunarDay + earthlyBranchIndex - 3, 6)"
    },
    {
      "id": "trace-lengths-equal-count-values",
      "range": {"lunarMonth": [1, 12], "lunarDay": [1, 30], "earthlyBranchIndex": [1, 12]},
      "assertion": "month.visitedPalaceIds.length === lunarMonth and day.visitedPalaceIds.length === lunarDay and hour.visitedPalaceIds.length === earthlyBranchIndex"
    },
    {
      "id": "identity-invariance",
      "assertion": "adding or changing non-core identity metadata cannot alter any palace result"
    },
    {
      "id": "palace-order-is-frozen",
      "assertion": "runtime palace order exactly equals the palaceOrder array in this file"
    }
  ]
}

    },
    {
      "id": "day-cycle-seven-equals-one",
      "description": "日期相差六，日宫周期一致",
      "input": {"lunarMonth": 1, "lunarDay": 7, "earthlyBranchIndex": 1},
      "expected": {"monthIndex": 0, "monthPalaceId": "da_an", "dayIndex": 0, "dayPalaceId": "da_an", "hourIndex": 0, "hourPalaceId": "da_an", "finalPalaceId": "da_an"}
    },
    {
      "id": "first-month-first-day-shen",
      "description": "申时序号九跨过完整周期",

{
  "schemaVersion": "1.0.0",
  "algorithmVersion": "1.0.0",
  "palaceOrder": ["da_an", "liu_lian", "su_xi", "chi_kou", "xiao_ji", "kong_wang"],
  "validCases": [
    {
      "id": "classical-example-third-month-fifth-day-chen",
      "description": "传统示例：农历三月初五辰时",
      "input": {"lunarMonth": 3, "lunarDay": 5, "earthlyBranchIndex": 5},
      "expected": {
        "monthIndex": 2,
        "monthPalaceId": "su_xi",
        "dayIndex": 0,
        "dayPalaceId": "da_an",
        "hourIndex": 4,
        "hourPalaceId": "xiao_ji",
        "finalPalaceId": "xiao_ji"
      },
      "sourceIds": ["yuxiaji-liuren-shike-web-transcription-8s8s"]
    },
    {
      "id": "minimum-input-all-da-an",
      "description": "正月初一子时，三个阶段均落大安",
      "input": {"lunarMonth": 1, "lunarDay": 1, "earthlyBranchIndex": 1},
      "expected": {"monthIndex": 0, "monthPalaceId": "da_an", "dayIndex": 0, "dayPalaceId": "da_an", "hourIndex": 0, "hourPalaceId": "da_an", "finalPalaceId": "da_an"}
    },
    {

      "id": "eighth-month-twenty-third-day-xu",
      "description": "日宫落空亡后继续起时",
      "input": {"lunarMonth": 8, "lunarDay": 23, "earthlyBranchIndex": 11},
      "expected": {"monthIndex": 1, "monthPalaceId": "liu_lian", "dayIndex": 5, "dayPalaceId": "kong_wang", "hourIndex": 3, "hourPalaceId": "chi_kou", "finalPalaceId": "chi_kou"}
    },
    {

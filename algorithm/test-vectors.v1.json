    },
    {
      "id": "first-month-second-day-zi",
      "description": "初二从大安顺数至留连",
      "input": {"lunarMonth": 1, "lunarDay": 2, "earthlyBranchIndex": 1},
      "expected": {"monthIndex": 0, "monthPalaceId": "da_an", "dayIndex": 1, "dayPalaceId": "liu_lian", "hourIndex": 1, "hourPalaceId": "liu_lian", "finalPalaceId": "liu_lian"}
    },
    {
      "id": "first-month-first-day-chou",
      "description": "丑时为第二个计数位置",
      "input": {"lunarMonth": 1, "lunarDay": 1, "earthlyBranchIndex": 2},
      "expected": {"monthIndex": 0, "monthPalaceId": "da_an", "dayIndex": 0, "dayPalaceId": "da_an", "hourIndex": 1, "hourPalaceId": "liu_lian", "finalPalaceId": "liu_lian"}
    },
    {
      "id": "sixth-month-sixth-day-sixtheth-branch",

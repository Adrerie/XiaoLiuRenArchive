{
  "name": "xiaoliurenarchive",
  "private": true,
  "version": "0.6.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:version && npm run audit:android:manifest && npm run validate:knowledge && npm run audit:network && vite build",
    "build:mobile": "npm run validate:version && npm run audit:android:manifest && npm run validate:knowledge && npm run audit:network && vite build --mode capacitor",
    "validate:version": "node scripts/validate-version.mjs",
    "validate:knowledge": "node scripts/validate-knowledge-manifest.mjs",
    "audit:network": "node scripts/audit-runtime-network.mjs",
    "audit:android:manifest": "node scripts/audit-android-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/core/index.test.ts",
    "test:core": "node --test --experimental-strip-types src/core/index.test.ts",
    "test:ethics": "node --test src/ethics/engine.test.mjs",
    "mobile:sync": "npm run build:mobile && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:build:debug": "npm run mobile:sync && node scripts/build-android-debug.mjs",
    "mobile:test:device": "npm run mobile:build:debug && node scripts/run-android-device-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
